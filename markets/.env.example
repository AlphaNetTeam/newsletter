SITE_URL=https://alphanet.global/markets

# Optional. Needed only for the "24H LIQUIDATION" row on the market metrics
# panel — Hyperliquid's own API has no liquidation endpoint, so that figure
# is fetched from HyperTracker instead (ht-api.coinmarketman.com, header
# "Authorization: Bearer <key>", GET /api/external/fills/liquidation — see
# docs.coinmarketman.com). HyperTracker has a genuine free tier (100
# tokens/day). Leave unset and the panel will show "Incorrect source" for
# that row rather than a fabricated number. Real key goes in .env.local
# (gitignored), not here.
HYPERTRACKER_API_KEY=
