[Unit]
Description=AlphaNet Markets
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wxf
Group=wxf
WorkingDirectory=/home/wxf/workspace/newsletter/markets
Environment=SITE_URL=https://alphanet.global/markets
Environment=NEXT_PUBLIC_SITE_URL=https://alphanet.global/markets
ExecStart=/home/wxf/.local/share/mise/installs/node/16/bin/npm start -- --hostname 127.0.0.1 --port 20002
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
