[Unit]
Description=Blog email subscription API (Deno)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/alphanet-space/newsletter/sub-app
ExecStart=/home/ubuntu/.deno/bin/deno task start
Restart=on-failure
RestartSec=60

Environment=PUBLIC_BASE_URL=https://alphanet.global
Environment=SMTP_HOST=smtpdm.aliyun.com
Environment=SMTP_PORT=80
Environment=SMTP_USER=support@send.alphanet.global
Environment=SMTP_PASS=Alphan98ClodNet
Environment=SMTP_FROM=AlphaNet support@send.alphanet.global

[Install]
WantedBy=multi-user.target
